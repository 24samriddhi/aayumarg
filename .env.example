# =====================================================================
# AayuMarg environment variables.  Copy this file to ".env.local" and fill it in.
# NEVER commit .env.local.  On Vercel add the same names in Project -> Settings -> Environment Variables.
# =====================================================================

# ---------- 1. Clerk (login) ----------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here

# ---------- 2. App mode ----------
# true  = demo mode (browser storage, no backend, no payment)
# false = REAL backend (Supabase + Razorpay + WhatsApp). Needs everything below.
NEXT_PUBLIC_USE_MOCKS=true
# Optional (defaults are fine): NEXT_PUBLIC_API_BASE_URL=/api   NEXT_PUBLIC_API_TIMEOUT_MS=15000
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_API_TIMEOUT_MS=

# ---------- 3. Supabase (database + file storage) ----------
# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# the "service_role" key (SECRET - server only, never NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ---------- 4. Payments: manual UPI (QR in public/upi-qr.png, UPI ID in lib/config/upi.ts) ----------
# Razorpay is NOT used right now. Doctor confirms each payment from the email link.
# Long random text (e.g. 40 characters). Signs the "Confirm payment" link in the doctor's email.
CONFIRM_SECRET=choose_a_long_random_string
# Your site address, no trailing slash. Local: http://localhost:3000   Live: https://your-domain.com
APP_URL=http://localhost:3000

# ---------- 5. Email alerts (Gmail) ----------
# Google Account -> Security -> 2-Step Verification ON -> App passwords -> create one (16 letters)
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Who gets the booking / payment emails (leave empty = same as GMAIL_USER)
NOTIFY_EMAIL_TO=
